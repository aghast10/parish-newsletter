# Email credentials (IMAP for receiving, SMTP for sending)
# Supports Gmail or any IMAP/SMTP provider.
#
# Option A: Gmail — use GMAIL_ADDRESS + GMAIL_APP_PASSWORD
GMAIL_ADDRESS=boletin@example.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# Option B: Generic provider — set these instead (or in addition)
# EMAIL_ADDRESS=boletin@example.com
# EMAIL_PASSWORD=your-password

# IMAP/SMTP server settings (defaults to Gmail if not set)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Admin email (receives the Brevo test email of each month's draft)
ADMIN_EMAIL=admin@example.com

# LLM API key: the one for llm.provider in config.yaml
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Brevo API key (Brevo → SMTP & API → API keys). List and sender are in config.yaml.
BREVO_API_KEY=xkeysib-...

# Only on the Windows PC that uploads to Brevo (windows/, scripts/brevo_relay.py):
# the private repository and a fine-grained token with Contents read and write on it.
# GITHUB_REPO=parroquia/boletin-parroquia
# GITHUB_TOKEN=github_pat_...
