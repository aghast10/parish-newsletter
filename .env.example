# Email credentials (IMAP for receiving, SMTP for sending)
# Supports Gmail or any IMAP/SMTP provider.
#
# Option A: Gmail — use GMAIL_ADDRESS + GMAIL_APP_PASSWORD
GMAIL_ADDRESS=boletin@example.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# Option B: Generic provider — set these instead (or in addition)
# EMAIL_ADDRESS=boletin@example.com
# EMAIL_PASSWORD=your-password

# IMAP/SMTP server settings (defaults to Gmail if not set)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Admin email (receives drafts for approval)
ADMIN_EMAIL=admin@example.com

# Mautic API credentials
MAUTIC_BASE_URL=https://mautic.parish.example
MAUTIC_USERNAME=api_user
MAUTIC_PASSWORD=api_password
